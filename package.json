{
  "name": "babyshop",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "bundle:size": "node scripts/check-bundle-budget.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run bundle:size"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@sentry/nextjs": "10.73.0",
    "@stripe/react-stripe-js": "6.8.2",
    "@stripe/stripe-js": "9.15.0",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "next": "16.3.4",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.13.0",
  "overrides": {
    "uuid": "11.1.1"
  }
}
