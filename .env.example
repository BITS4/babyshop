# Firebase web configuration (public identifiers; use your own Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-babyshop.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-babyshop
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-babyshop.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Stripe browser and server credentials
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# Firebase Admin: use Application Default Credentials or this JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional structured logging and Sentry error tracking
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
